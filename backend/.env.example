# --- Bật/tắt từng đề bài (repository-structure.md §7) ---
# Bỏ tên ra khỏi danh sách là tắt hẳn module đó, không cần refactor.
ENABLED_MODULES=seat,locker,mail,document

# --- Database ---
DATABASE_URL=postgresql+psycopg://supportive:supportive@localhost:5433/supportive_ai
DB_ECHO=false

# --- Bảo mật ---
# Bắt buộc đổi ở môi trường thật. Tối thiểu 32 byte cho HS256.
SECRET_KEY=dev-only-change-me-32-bytes-minimum!!
ACCESS_TOKEN_TTL_MINUTES=480
# Hạn của link xác nhận gửi kèm thông báo (mail-tracking.md §12). Phải dài
# hơn mốc tồn đọng T+5 — người nhận vẫn lấy hàng được sau mốc đó.
CONFIRM_TOKEN_TTL_HOURS=168
# Địa chỉ điện thoại người nhận mở được — dựng link trong email và URL trong
# mã QR dán tại khu để đơn. Không có dấu / ở cuối. Môi trường thật phải là https.
PUBLIC_BASE_URL=http://localhost:3000

# --- Lịch làm việc, dùng để tính SLA theo giờ làm việc (§8.4) ---
# CHƯA CHỐT: các giá trị dưới đây là tạm đặt, chưa lấy từ quy định thật.
# 0 = Thứ Hai ... 6 = Chủ Nhật
BUSINESS_DAYS=0,1,2,3,4
BUSINESS_START=08:00
BUSINESS_END=17:00
BUSINESS_BREAK_START=12:00
BUSINESS_BREAK_END=13:00
TIMEZONE=Asia/Ho_Chi_Minh

# --- Gửi email ---
# Để trống SMTP_HOST thì hệ thống chỉ lưu thông báo vào bảng notification,
# KHÔNG gửi đi đâu — tiện chạy thử toàn bộ luồng trước khi có thông số thật.
SMTP_HOST=
SMTP_PORT=587
SMTP_USE_STARTTLS=true          # cổng 587. Dùng cổng 465 thì đổi sang SMTP_USE_SSL=true
SMTP_USE_SSL=false
SMTP_USERNAME=
SMTP_PASSWORD=
# Nên là hộp thư dùng chung của Phòng HC, không phải email cá nhân:
# người nhận bấm Reply thì thư về đúng chỗ.
MAIL_FROM=
MAIL_FROM_NAME=Phòng Hành chính

# --- Đề 3: chuyển phát nhanh ---
# In thẳng vào email — ghi rõ tầng và vị trí, mơ hồ là người nhận tìm nhầm chỗ.
MAIL_PICKUP_LOCATION=Khu vực chuyển phát nhanh
# Mã nhúng trong QR dán tại khu để đơn. Để trống = ai cũng gọi được endpoint
# tra cứu/xác nhận. Xem ghi chú ⚠️ đầu file mail/router.py.
MAIL_STATION_TOKEN=
# Chu kỳ quét mốc nhắc hạn (T+2) và tồn đọng (T+5).
MAIL_JOB_INTERVAL_MINUTES=60
# Bậc khớp theo số điện thoại. File lễ tân hiện KHÔNG có cột này nên để
# false. Khi nào lễ tân thêm cột thì bật lên — không phải sửa code (CR-001 D7).
MAIL_MATCH_BY_PHONE=false
# Ngưỡng "tên gần đúng" ở bậc khớp fuzzy. Tạm đặt, hiệu chỉnh sau vài lô thật.
MAIL_NAME_FUZZY_THRESHOLD=0.85
# Dòng nằm ở "Chờ khớp" quá ngần này ngày thì đẩy lên đầu màn hình và cảnh
# báo cho HC. KHÔNG tự chuyển sang "Tồn đọng" — hai thứ đó khác nhau.
MAIL_PENDING_MATCH_ALERT_DAYS=2

# --- Danh mục nhân sự ---
# Tên miền của TÀI KHOẢN AD (UPN), ví dụ vingroup.net. Nếu cột `email` nhập
# vào trùng tên miền này thì gần như chắc chắn HR lấy nhầm cột tài khoản sang
# cột hộp thư — hệ thống cảnh báo ngay ở màn hình nhập danh mục.
#
# Đây là lỗi im lặng nguy hiểm nhất: thư không tới ai, nhưng SMTP vẫn nhận và
# hệ thống vẫn báo gửi thành công. Để trống thì bỏ qua kiểm tra.
UPN_DOMAIN_HINT=

# --- Lưu trữ file ---
STORAGE_ROOT=./var/storage

# Thư mục build của frontend. Đặt khi chạy production một cổng duy nhất:
# backend phục vụ luôn trang, nên không cần CORS. Để trống lúc phát triển —
# Vite tự phục vụ và proxy /api sang đây.
# FRONTEND_DIST=../frontend/dist

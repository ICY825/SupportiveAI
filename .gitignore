*.key
*.p12
*.pfx
*.crt
*.jks

# FastAPI / Backend
*.log
logs/
*.sqlite
*.sqlite3
*.db
*.db-journal

# AI / Models - chỉ ignore thư mục models ở root, tránh đè lên source code
/models/
*.bin
*.onnx
*.pt
*.pth
*.ckpt
*.safetensors

# Storage - chỉ ignore dữ liệu runtime, KHÔNG ignore source package backend/app/platform/storage
/var/
/storage/
/uploads/
/minio_data/
backend/var/
# Đảm bảo source code không bị ignore do rule storage/ cũ (nếu từng dùng storage/ không có /)
!backend/app/platform/storage/
!backend/app/platform/storage/**


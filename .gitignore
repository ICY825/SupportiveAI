# Python
__pycache__/
*.py[cod]
*.pyo
*.pyd
.venv/
venv/
ENV/
env/
.python-version

# Env / Secrets - BẮT BUỘC ignore, chứa SECRET_KEY, DATABASE_URL, SMTP_PASSWORD
.env
.env.*
!.env.example

# Chứng chỉ & khóa riêng - không bao giờ đưa lên repo
